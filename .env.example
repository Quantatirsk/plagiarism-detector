# API Configuration
API_V1_PREFIX="/api/v1"
PROJECT_NAME="Plagiarism Detector"
VERSION="1.0.0"

# OpenAI Configuration
OPENAI_API_KEY="sk-XXX"
OPENAI_BASE_URL="https://api.vect.one/v1"

LLM_MODEL="google/gemini-2.5-flash-lite"                # LLM model for report generation (uses OPENAI_API_KEY and OPENAI_BASE_URL)

EMBEDDING_MODEL="dengcao/Qwen3-Embedding-8B:Q5_K_M"
EMBEDDING_DIMENSIONS=4096
EMBEDDING_BATCH_SIZE=50


# Reranker Configuration
RERANKER_PROVIDER="openai"                   # Options: "jina" or "openai" (default: openai)

# OpenAI Reranker Configuration
RERANKER_MODEL="Qwen3-Reranker-0.6B"
RERANKER_OPENAI_BASE_URL="https://api.vect.one/v1"  # Use same as embedding API
RERANKER_OPENAI_API_KEY="sk-rNsVp8nSBHjEUqLIktGkXb4da4f7U3lZGDIRp4MpTW6LKasC"  # Use same as embedding API

# Milvus Configuration
MILVUS_MODE="local"                    # 本地开发模式
MILVUS_DB_FILE="milvus_demo.db"        # 本地数据库文件
MILVUS_HOST="115.159.192.25"            # 生产服务器地址
MILVUS_PORT=19530                       # 生产服务器端口
MILVUS_COLLECTION="documents"          # 集合名称

# JINA AI Configuration
JINA_API_KEY="jina_8a856d5247d64a999294a83743d0eb2cquhWj-se4WB2sby0N8ukMbVy0t1y"


# Redis Configuration (可选，暂不使用)
REDIS_URL="redis://localhost:6379"
REDIS_TTL=3600

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30

# Detection Configuration
PARAGRAPH_SIMILARITY_THRESHOLD=0.75
SENTENCE_SIMILARITY_THRESHOLD=0.80
TOP_K_PARAGRAPHS=50

# CORS Configuration
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:3000"
CORS_ALLOW_CREDENTIALS=false

# ===== OCR服务配置 (MinerU) =====
OCR_BASE_URL="http://your-ocr-server:7000"
OCR_TIMEOUT=1200
MINERU_BACKEND="pipeline"
MINERU_PARSE_METHOD="auto"
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_RESPONSE_FORMAT_ZIP=true

# ===== 翻译服务配置 =====
MTRANS_BASE_URL="https://your-translation-service"
MTRANS_TOKEN="your-token"

# ===== 数据库配置 =====
DB_TYPE="sqlite"
DB_HOST="localhost"
DB_PORT=3306
DB_USER=""
DB_PASSWORD=""
DB_NAME="plagiarism"

# ===== AI服务配置 =====
# DashScope API Key - 用于ASR语音识别等服务
DASHSCOPE_API_KEY="sk-your-dashscope-key"
